# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=notification_user
DB_PASSWORD=notification_secret
DB_NAME=notification_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25

# Message Broker & Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Channel Rate Limits (Messages per second)
RATE_LIMIT_SMS=100
RATE_LIMIT_EMAIL=100
RATE_LIMIT_PUSH=100

# Provider Webhook Configuration
# Use local mock provider: http://localhost:8081/webhook
# Or replace with your webhook.site URL: https://webhook.site/YOUR-UUID
PROVIDER_WEBHOOK_URL=http://localhost:8081/webhook
PROVIDER_TIMEOUT_SECONDS=5
MAX_RETRIES=3
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
